<%- include('partials/header') %>

<style>
  :root { --echo-green:#2d7a3a; --echo-light:#eaf3de; }
  .not-found-wrap { padding: 4rem 1rem; }
  .not-found-card { background:#fff; border:1px solid #e0e0e0; border-radius:12px; padding:3.5rem 2rem; max-width:480px; margin:0 auto; text-align:center; box-shadow: 0 4px 20px rgba(0,0,0,0.04); }
  .not-found-icon { font-size:4.5rem; color:var(--echo-green); margin-bottom:1rem; }
  .not-found-card h1 { font-size:2rem; font-weight:700; color:#222; margin-bottom:0.5rem; }
  .not-found-card p { font-size:15px; color:#666; margin-bottom:2rem; }
  .btn-home { padding:10px 24px; background:var(--echo-green); color:#fff; border:none; border-radius:8px; font-size:15px; text-decoration:none; display:inline-flex; align-items:center; gap:8px; font-weight:600; transition:background .15s; }
  .btn-home:hover { background:#245f2d; }
</style>

<div class="auth-container not-found-wrap">
  <div class="not-found-card">
    <div class="not-found-icon"><i class="fa-regular fa-compass"></i></div>
    <h1>404 — Page Not Found</h1>
    <p>The page you're looking for doesn't exist or may have been moved.</p>
    <a href="/" class="btn-home"><i class="fa-solid fa-house"></i> Go Home</a>
  </div>
</div>

<%- include('partials/footer') %>